; Dual-strategy duel. Two Soft boards share one bag sequence. Left runs the
; aggressive place-fn worldline, right the defensive one. C only blits.
; hot-strategy:swap! / heal! move the live tetris:place-fn slot when
; select-best or a storm changes the winner. Not Restricted mode, not AOT.
(load "/workspace/aura-tetris/soft/tetris/world.aura")
(load "/workspace/aura-tetris/soft/tetris/strategy.aura")
(require "std/string" all:)
(require "std/process" all:)

(define *hold-type* -1)
(define *hold-lock* 0)
(define *drop-acc* 0)
(define *next-type* 0)
(define *seq-i* 0)
(define *rng* 12345)
(define *seq* (make-vector 280 0))
(define *seq-n* 280)
(define *side-l* (make-vector 16 0))
(define *side-r* (make-vector 16 0))
(define *board-l* (make-vector 200 0))
(define *board-r* (make-vector 200 0))
(define *pilot* 0)
(define *winner-mid* 1)
(define *winner-side* "L")
(define *winner-reason* "boot")
(define *script-ticks* 0)
; 1 = hot-strategy:swap! the live slot onto the winner worldline.
; Left at 0 during board copies: a swap snapshots the matrix and makes
; later cell writes much slower. The script commits once, after both
; worldlines have played.
(define *commit-live* 0)

(define (elog! msg)
  (try (sh (string-append "echo " msg " >&2")) (catch (e) 0)))

(define (rng-next!)
  (set! *rng* (modulo (+ (* (modulo *rng* 65536) 251) 17) 65536))
  *rng*)

(define (rev xs)
  (let loop ((ys xs) (acc '()))
    (if (null? ys) acc
        (loop (cdr ys) (cons (car ys) acc)))))

(define (drop-nth xs i)
  (let loop ((ys xs) (j 0) (pre '()))
    (if (null? ys)
        (cons 0 '())
        (if (= j i)
            (cons (car ys) (append (rev pre) (cdr ys)))
            (loop (cdr ys) (+ j 1) (cons (car ys) pre))))))

(define (shuffle-bag)
  (let loop ((src (list 0 1 2 3 4 5 6)) (n 7) (acc '()))
    (if (= n 0)
        acc
        (let* ((i (modulo (rng-next!) n))
               (pr (drop-nth src i)))
          (loop (cdr pr) (- n 1) (cons (car pr) acc))))))

(define (fill-seq!)
  (let loop ((i 0) (bag '()))
    (if (>= i *seq-n*)
        i
        (if (null? bag)
            (loop i (shuffle-bag))
            (begin
              (vector-set! *seq* i (car bag))
              (loop (+ i 1) (cdr bag)))))))

(define (seq-at i)
  (vector-ref *seq* (modulo i *seq-n*)))

(define (side-vec which)
  (if (= which 0) *side-l* *side-r*))

(define (side-board which)
  (if (= which 0) *board-l* *board-r*))

(define (save-side! which)
  (let ((s (side-vec which))
        (b (side-board which)))
    (vector-set! s 0 *lines*)
    (vector-set! s 1 *score*)
    (vector-set! s 2 *level*)
    (vector-set! s 3 *alive*)
    (vector-set! s 4 *tick*)
    (vector-set! s 5 *px*)
    (vector-set! s 6 *py*)
    (vector-set! s 7 *prot*)
    (vector-set! s 8 *ptype*)
    (vector-set! s 9 *active*)
    (vector-set! s 10 *hold-type*)
    (vector-set! s 11 *hold-lock*)
    (vector-set! s 12 *drop-acc*)
    (vector-set! s 13 *next-type*)
    (vector-set! s 14 *seq-i*)
    (let loop ((i 0))
      (if (< i *board-cap*)
          (begin
            (vector-set! b i (vector-ref *board* i))
            (loop (+ i 1)))
          which))))

(define (load-side! which)
  (let ((s (side-vec which))
        (b (side-board which)))
    (set! *lines* (vector-ref s 0))
    (set! *score* (vector-ref s 1))
    (set! *level* (vector-ref s 2))
    (set! *alive* (vector-ref s 3))
    (set! *tick* (vector-ref s 4))
    (set! *px* (vector-ref s 5))
    (set! *py* (vector-ref s 6))
    (set! *prot* (vector-ref s 7))
    (set! *ptype* (vector-ref s 8))
    (set! *active* (vector-ref s 9))
    (set! *hold-type* (vector-ref s 10))
    (set! *hold-lock* (vector-ref s 11))
    (set! *drop-acc* (vector-ref s 12))
    (set! *next-type* (vector-ref s 13))
    (set! *seq-i* (vector-ref s 14))
    (let loop ((i 0))
      (if (< i *board-cap*)
          (begin
            (vector-set! *board* i (vector-ref b i))
            (loop (+ i 1)))
          which))))

(define (init-side! which)
  (tetris:reset!)
  (set! *hold-type* -1)
  (set! *hold-lock* 0)
  (set! *drop-acc* 0)
  (set! *seq-i* 2)
  (set! *next-type* (seq-at 1))
  (tetris:spawn! (seq-at 0))
  (save-side! which))

(define (duel-spawn-next!)
  (let ((t *next-type*))
    (set! *next-type* (seq-at *seq-i*))
    (set! *seq-i* (+ *seq-i* 1))
    (tetris:spawn! t)))

(define (drop-interval)
  (let ((k (- 16 *level*)))
    (if (< k 2) 2 k)))

(define (duel-lock!)
  (tetris:lock!)
  (set! *hold-lock* 0)
  (tetris:explain! *strat-mid* "lock")
  (if (= *alive* 1)
      (duel-spawn-next!)
      #f))

(define (duel-gravity!)
  (if (= *alive* 0)
      #f
      (begin
        (set! *tick* (+ *tick* 1))
        (set! *drop-acc* (+ *drop-acc* 1))
        (if (< *drop-acc* (drop-interval))
            #t
            (begin
              (set! *drop-acc* 0)
              (if (= *active* 0)
                  (duel-spawn-next!)
                  (if (not (tetris:soft-drop!))
                      (duel-lock!))))))))

(define (duel-hold!)
  (if (or (= *alive* 0) (= *active* 0) (= *hold-lock* 1))
      #f
      (begin
        (set! *hold-lock* 1)
        (if (< *hold-type* 0)
            (begin
              (set! *hold-type* *ptype*)
              (set! *active* 0)
              (duel-spawn-next!))
            (let ((t *hold-type*))
              (set! *hold-type* *ptype*)
              (set! *active* 0)
              (tetris:spawn! t))))))

(define (duel-do-verb! m)
  (cond ((string=? m "left") (tetris:move! -1))
        ((string=? m "right") (tetris:move! 1))
        ((string=? m "soft") (tetris:soft-drop!))
        ((string=? m "cw") (tetris:rotate!))
        ((string=? m "ccw") (tetris:rotate-ccw!))
        ((string=? m "hold") (duel-hold!))
        ((string=? m "hard")
         (if (= *active* 1)
             (begin
               (tetris:hard-drop!)
               (set! *hold-lock* 0)
               (tetris:explain! *strat-mid* "lock")
               (if (= *alive* 1) (duel-spawn-next!)))
             #f))
        (#t #f)))

(define (side-auto! which)
  (load-side! which)
  (set! *score-mode* (if (= which 0) 1 2))
  (if (and (= *alive* 1) (= *active* 1))
      (let ((m (tetris:choose-move)))
        (if (not (or (string=? m "none") (string=? m "auto")))
            (duel-do-verb! m))))
  (save-side! which)
  (set! *score-mode* 0)
  which)

(define (side-gravity! which)
  (load-side! which)
  (duel-gravity!)
  (save-side! which))

(define (preview6 which)
  (let ((s (side-vec which)))
    (let ((n (vector-ref s 13))
          (i (vector-ref s 14)))
      (list n
            (seq-at i)
            (seq-at (+ i 1))
            (seq-at (+ i 2))
            (seq-at (+ i 3))
            (seq-at (+ i 4))))))

(define (duel:stamp-winner! mid side reason)
  (set! *winner-mid* mid)
  (set! *winner-side* side)
  (set! *winner-reason* reason)
  (set! *strat-mid* mid)
  (set! *strat-reason* reason)
  (tetris:explain! mid reason)
  mid)

; Lines then score. A dead board loses to a living one (survive).
(define (duel:select-best!)
  (let ((la (vector-ref *side-l* 3))
        (ra (vector-ref *side-r* 3))
        (ll (vector-ref *side-l* 0))
        (rl (vector-ref *side-r* 0))
        (ls (vector-ref *side-l* 1))
        (rs (vector-ref *side-r* 1)))
    (cond
      ((and (= la 1) (= ra 0))
       (duel:stamp-winner! 1 "L" "survive"))
      ((and (= la 0) (= ra 1))
       (duel:stamp-winner! 2 "R" "survive"))
      ((or (> ll rl) (and (= ll rl) (> ls rs)))
       (duel:stamp-winner! 1 "L" "lines_lead"))
      ((or (> rl ll) (and (= rl ll) (> rs ls)))
       (duel:stamp-winner! 2 "R" "lines_lead"))
      (#t
       (duel:stamp-winner! 1 "L" "lines_lead"))))
  (if (or (= *storm-on* 1) (= *commit-live* 0))
      *winner-mid*
      (let ((body (if (= *winner-mid* 2) *def-body* *agg-body*)))
        (if (not (string=? *place-live* body))
            (tetris:apply-strategy! body))
        (set! *strat-mid* *winner-mid*)
        (set! *strat-reason* *winner-reason*)
        (tetris:explain! *winner-mid* *winner-reason*)
        *winner-mid*)))

(define (duel:after-step!)
  (tetris:storm-update! (preview6 0))
  (duel:select-best!))

(define (row-snap y)
  (let loop ((x 0) (acc ""))
    (if (>= x *W*)
        acc
        (let ((v (cell-ref x y)))
          (loop (+ x 1)
                (string-append acc
                               (if (= v 0) "." (number->string v))))))))

(define (board-snap)
  (let loop ((y 0) (acc ""))
    (if (>= y *H*)
        acc
        (loop (+ y 1)
              (string-append acc (row-snap y) "\n")))))

(define (cells-snap)
  (if (= *active* 0)
      ""
      (let loop ((cs (shape-cells *ptype* *prot*)) (acc ""))
        (if (null? cs)
            acc
            (let* ((c (car cs))
                   (cx (+ *px* (nth c 0)))
                   (cy (+ *py* (nth c 1)))
                   (bit (string-append (number->string cx) "," (number->string cy))))
              (loop (cdr cs)
                    (if (string=? acc "")
                        bit
                        (string-append acc ";" bit))))))))

(define (piece-line tag)
  (string-append
    tag
    " active=" (number->string *active*)
    " type=" (number->string *ptype*)
    " rot=" (number->string *prot*)
    " x=" (number->string *px*)
    " y=" (number->string *py*)
    " cells=" (cells-snap) "\n"))

(define (score-line tag)
  (string-append
    tag
    " score=" (number->string *score*)
    " lines=" (number->string *lines*)
    " level=" (number->string *level*) "\n"))

(define (status-line tag)
  (string-append
    tag
    " alive=" (number->string *alive*)
    " tick=" (number->string *tick*) "\n"))

(define (side-block which board-tag piece-tag next-tag hold-tag score-tag status-tag)
  (load-side! which)
  (string-append
    board-tag "\n"
    (board-snap)
    (piece-line piece-tag)
    next-tag " " (number->string *next-type*) "\n"
    hold-tag " " (number->string *hold-type*) "\n"
    (score-line score-tag)
    (status-line status-tag)))

(define (duel:apply-width! body)
  (let ((old *W*))
    (let ((r (tetris:apply-rule! "tetris:rule-width" body "rule_width")))
      ; apply-rule retargets the live matrix. Saved sides still use `old`.
      (if (and (pair? r) (equal? (car r) #t) (not (= old *W*)))
          (begin
            (set! *board-l* (tetris:remap-board *board-l* old *W*))
            (set! *board-r* (tetris:remap-board *board-r* old *W*))))
      (if (and (pair? r) (equal? (car r) #t))
          (set! *rule-phase* (if (= *W* 12) 1 0)))
      r)))

(define (duel:mutate-wide!)
  (duel:apply-width! (if (= *W* 12) "(lambda () 10)" "(lambda () 12)")))

(define (duel:mutate-cycle!)
  (cond ((= *rule-phase* 0) (duel:mutate-wide!))
        ((= *rule-phase* 1) (tetris:mutate-score!))
        (#t
         (duel:apply-width! "(lambda () 10)")
         (tetris:apply-rule! "tetris:rule-score" *score-classic* "rule_score")
         (set! *rule-phase* 0)
         (set! *strat-reason* "rule_heal")
         (tetris:explain! 4 "rule_heal")
         (list #t "rule_heal"))))

(define (tetris:duel-snapshot-text)
  (string-append
    "SNAP v1\n"
    "WIDTH " (number->string *W*) "\n"
    (side-block 0 "BOARD" "PIECE" "NEXT" "HOLD" "SCORE" "STATUS")
    (side-block 1 "BOARD2" "PIECE2" "NEXT2" "HOLD2" "SCORE2" "STATUS2")
    "PILOT side=" (if (= *pilot* 0) "L" "R") "\n"
    "WINNER mid=" (number->string *winner-mid*)
    " side=" *winner-side*
    " reason=" *winner-reason* "\n"
    "MID mid=" (number->string *strat-mid*)
    " reason=" *strat-reason* "\n"
    "EXPLAIN mid=" (number->string *explain-mid*)
    " reason=" *explain-reason* "\n"
    (tetris:race-snap-extra)
    "END\n"))

(define (emit-snap!)
  (display (tetris:duel-snapshot-text)))

(define (fp-of which)
  (load-side! which)
  (let loop ((i 0) (acc 0))
    (if (>= i *board-cap*)
        (+ acc (+ (* *px* 3)
                  (+ (* *prot* 17)
                     (+ (* *py* 19)
                        (+ (* *ptype* 13) (* *seq-i* 7))))))
        (loop (+ i 1) (+ acc (* (+ i 1) (vector-ref *board* i)))))))

(define (duel:boot!)
  (let ((seeded (tetris:strategy-seed!)))
    (if (not (and (pair? seeded) (equal? (car seeded) #t)))
        #f
        (begin
          (set! *rng* 12345)
          (fill-seq!)
          (init-side! 0)
          (init-side! 1)
          (set! *pilot* 0)
          (set! *script-ticks* 0)
          (set! *storm-on* 0)
          (duel:select-best!)
          #t))))

(define (duel:script-tick!)
  (side-gravity! 0)
  (side-gravity! 1)
  (side-auto! 0)
  (side-auto! 1)
  (duel:after-step!)
  (set! *script-ticks* (+ *script-ticks* 1))
  *script-ticks*)

(define (arm-live!)
  (tetris:reset!)
  (set! *hold-type* -1)
  (set! *hold-lock* 0)
  (set! *drop-acc* 0)
  (set! *seq-i* 2)
  (set! *next-type* (seq-at 1))
  (tetris:spawn! (seq-at 0)))

(define (fp-live)
  (let loop ((i 0) (acc 0))
    (if (>= i *board-cap*)
        (+ acc (+ (* *px* 3)
                  (+ (* *prot* 17)
                     (+ (* *py* 19)
                        (+ (* *ptype* 13) (* *seq-i* 7))))))
        (loop (+ i 1) (+ acc (* (+ i 1) (vector-ref *board* i)))))))

(define (remember! which)
  (let ((s (side-vec which)))
    (vector-set! s 0 *lines*)
    (vector-set! s 1 *score*)
    (vector-set! s 3 *alive*)
    which))

; One worldline, whole game, on the live matrix. No per-tick board copy.
(define (run-live! n)
  (let loop ((i 0))
    (if (< i n)
        (begin
          (duel-gravity!)
          (if (and (= *alive* 1) (= *active* 1))
              (let ((m (tetris:choose-move)))
                (if (not (or (string=? m "none") (string=? m "auto")))
                    (duel-do-verb! m))))
          (loop (+ i 1)))
        n)))

(define (duel:script! n)
  (let ((seeded (tetris:strategy-seed!)))
    (if (not (and (pair? seeded) (equal? (car seeded) #t)))
        (display "TETRIS_M2_DUEL_FAIL seed\n")
        (begin
          (set! *rng* 12345)
          (fill-seq!)
          (set! *commit-live* 0)
          (set! *storm-on* 0)
          (set! *score-mode* 1)
          (arm-live!)
          (run-live! n)
          (let ((fl (fp-live)))
            (remember! 0)
            (set! *score-mode* 2)
            (arm-live!)
            (run-live! n)
            (let ((fr (fp-live)))
              (remember! 1)
              (set! *script-ticks* n)
              (set! *commit-live* 1)
              (duel:select-best!)
              (set! *score-mode* 0)
              (display "TICKS=")
              (display (number->string *script-ticks*))
              (newline)
              (display "FP_L=")
              (display (number->string fl))
              (newline)
              (display "FP_R=")
              (display (number->string fr))
              (newline)
              (display "WINNER mid=")
              (display (number->string *winner-mid*))
              (display " side=")
              (display *winner-side*)
              (display " reason=")
              (display *winner-reason*)
              (newline)
              (display "mid=")
              (display (number->string *explain-mid*))
              (newline)
              (display "reason=")
              (display *explain-reason*)
              (newline)
              (if (and (not (= fl fr)) (> *winner-mid* 0))
                  (display "TETRIS_M2_DUEL_OK\n")
                  (begin
                    (display "TETRIS_M2_DUEL_FAIL diverge\n")
                    (display (number->string fl))
                    (newline)
                    (display (number->string fr))
                    (newline)))))))))

(define (apply-pilot! v)
  (load-side! *pilot*)
  (set! *score-mode* (if (= *pilot* 0) 1 2))
  (duel-do-verb! v)
  (save-side! *pilot*)
  (set! *score-mode* 0))

(define (handle-line! line)
  (let ((parts (string-split line " ")))
    (if (or (null? parts) (not (string=? (car parts) "INPUT")))
        (list 0)
        (let ((verb (if (null? (cdr parts)) "" (car (cdr parts)))))
          (if (string=? verb "quit")
              (begin
                (set! *commit-live* 1)
                (duel:select-best!)
                (list 1))
              (begin
                (cond
                  ((string=? verb "toggle")
                   (set! *pilot* (if (= *pilot* 0) 1 0))
                   (tetris:explain! (if (= *pilot* 0) 1 2) "toggle"))
                  ((string=? verb "auto")
                   (side-auto! 0)
                   (side-auto! 1))
                  ((string=? verb "tick")
                   (side-gravity! 0)
                   (side-gravity! 1)
                   (side-auto! (if (= *pilot* 0) 1 0)))
                  ((string=? verb "restart")
                   (duel:boot!))
                  ((string=? verb "race")
                   (load-side! *pilot*)
                   (tetris:race!)
                   (set! *winner-mid* *race-mid*)
                   (set! *winner-side* *race-side*)
                   (set! *winner-reason* *race-reason*)
                   (save-side! *pilot*))
                  ((string=? verb "mutate")
                   (duel:mutate-cycle!))
                  ((string=? verb "mutate-wide")
                   (duel:mutate-wide!))
                  ((string=? verb "mutate-score")
                   (tetris:mutate-score!))
                  ((string=? verb "propose")
                   (tetris:propose!))
                  (#t
                   (apply-pilot! verb)))
                (if (not (or (string=? verb "restart")
                             (string=? verb "race")
                             (string=? verb "mutate")
                             (string=? verb "mutate-wide")
                             (string=? verb "mutate-score")
                             (string=? verb "propose")))
                    (duel:after-step!))
                (list 0)))))))

(define (duel:play!)
  (if (not (duel:boot!))
      (begin
        (elog! "TETRIS_DUEL_SEED_FAIL")
        (error "tetris duel strategy seed failed"))
      (begin
        (emit-snap!)
        (elog! "TETRIS_DUEL_READY")
        (let loop ()
          (let ((line (read-line)))
            (if (not (string? line))
                (begin (elog! "TETRIS_DUEL_EOF") (void))
                (begin
                  (tetris:maybe-propose!)
                  (let ((res (handle-line! line)))
                    (if (= (car res) 1)
                        (begin (elog! "TETRIS_DUEL_QUIT") (void))
                        (begin
                          (emit-snap!)
                          (loop)))))))))))

; Same as play.aura: build closures before race.aura or cons/* go missing.
(load "/workspace/aura-tetris/soft/tetris/race.aura")
(load "/workspace/aura-tetris/soft/tetris/rules.aura")
(load "/workspace/aura-tetris/soft/tetris/propose.aura")
