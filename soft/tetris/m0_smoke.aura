; Deterministic M0 smoke:
; Four times: fill bottom cols 0..5, hard-drop horizontal I into 6..9 → clear 1 line.
; Expect LINES=4 SCORE=400 (level 1: 4 * 100).
(load "/workspace/aura-tetris/soft/tetris/world.aura")

(tetris:reset!)
(tetris:drop-I-clear!)
(tetris:drop-I-clear!)
(tetris:drop-I-clear!)
(tetris:drop-I-clear!)

(display "LINES=")
(display (number->string *lines*))
(newline)
(display "SCORE=")
(display (number->string *score*))
(newline)
(display "TETRIS_M0_OK")
(newline)
