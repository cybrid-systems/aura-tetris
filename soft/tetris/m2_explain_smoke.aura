; Known swap: a score-tampering body is gate_reject, a good body swaps,
; a non-numeric body heals. The heal stamp is the token's mid/reason.
(load "/workspace/aura-tetris/soft/tetris/world.aura")
(load "/workspace/aura-tetris/soft/tetris/strategy.aura")

(define (ok-pair? r tag)
  (and (pair? r) (equal? (car r) #t) (equal? (car (cdr r)) tag)))

(define (fail-pair? r tag)
  (and (pair? r) (equal? (car r) #f) (equal? (car (cdr r)) tag)))

(define (main)
  (let ((seeded (tetris:strategy-seed!)))
    (if (not (ok-pair? seeded "seed"))
        (display "TETRIS_M2_EXPLAIN_FAIL seed\n")
        (let ((bad "(lambda (board piece) (begin (set! *score* 99) board))")
              (good "(lambda (board piece) (if (number? board) (+ board 7) 1))")
              (ugly "(lambda (board piece) (cons board piece))"))
          (let ((rbad (tetris:apply-strategy! bad)))
            (if (not (and (fail-pair? rbad "gate")
                          (string=? *explain-reason* "gate_reject")
                          (= *explain-mid* 1)))
                (begin
                  (display "TETRIS_M2_EXPLAIN_FAIL gate_reject\n")
                  (display *explain-reason*)
                  (newline))
                (let ((rgood (tetris:apply-strategy! good)))
                  (if (not (and (ok-pair? rgood "swap")
                                (string=? *explain-reason* "swap")
                                (= *explain-mid* 1)
                                (= (tetris:place-fn 3 1) 10)))
                      (begin
                        (display "TETRIS_M2_EXPLAIN_FAIL swap\n")
                        (display *explain-reason*)
                        (newline))
                      (let ((rugly (tetris:apply-strategy! ugly)))
                        (if (and (fail-pair? rugly "probe")
                                 (string=? *strat-reason* "heal")
                                 (string=? *explain-reason* "heal")
                                 (= *explain-mid* 1)
                                 (= (tetris:place-fn 3 1) 10))
                            (begin
                              (display "mid=")
                              (display (number->string *explain-mid*))
                              (newline)
                              (display "reason=")
                              (display *explain-reason*)
                              (newline)
                              (display "TETRIS_M2_EXPLAIN_OK\n"))
                            (begin
                              (display "TETRIS_M2_EXPLAIN_FAIL heal\n")
                              (display *explain-reason*)
                              (newline)
                              (display *strat-reason*)
                              (newline))))))))))))

(main)
