; A run of S/Z swaps the live slot to the defensive worldline (storm_sz).
; A calm next-6 heals back. Soft hot-strategy, not a set! of the score.
(load "/workspace/aura-tetris/soft/tetris/world.aura")
(load "/workspace/aura-tetris/soft/tetris/strategy.aura")

(define (main)
  (let ((seeded (tetris:strategy-seed!)))
    (if (not (and (pair? seeded) (equal? (car seeded) #t)))
        (display "TETRIS_M2_STORM_FAIL seed\n")
        (let ((storm (list 4 6 4 6 4 6))
              (calm (list 0 1 2 3 0 1)))
          (let ((r (tetris:storm-update! storm)))
            (if (not (and (pair? r)
                          (equal? (car r) #t)
                          (equal? (car (cdr r)) "storm_sz")
                          (string=? *explain-reason* "storm_sz")
                          (string=? *strat-reason* "storm_sz")
                          (= *explain-mid* 2)
                          (= *storm-on* 1)
                          (< (tetris:place-fn 4 0) 0)
                          (= *score* 0)))
                (begin
                  (display "TETRIS_M2_STORM_FAIL enter\n")
                  (display *explain-reason*)
                  (newline)
                  (display (tetris:place-fn 4 0))
                  (newline))
                (let ((h (tetris:storm-update! calm)))
                  (if (and (pair? h)
                           (equal? (car h) #t)
                           (string=? *explain-reason* "heal")
                           (string=? *strat-reason* "heal")
                           (= *storm-on* 0)
                           (= (tetris:place-fn 4 0) 4)
                           (= *score* 0)
                           (= *lines* 0))
                      (begin
                        (display "mid=")
                        (display (number->string *explain-mid*))
                        (newline)
                        (display "reason=")
                        (display *explain-reason*)
                        (newline)
                        (display "TETRIS_M2_STORM_OK\n"))
                      (begin
                        (display "TETRIS_M2_STORM_FAIL heal\n")
                        (display *explain-reason*)
                        (newline)
                        (display (tetris:place-fn 4 0))
                        (newline))))))))))

(main)
