; Four fingerprints on one locked board + one T. Winner is tetris-hunt
; because it is the only landing that clears a line.
(load "/workspace/aura-tetris/soft/tetris/world.aura")
(load "/workspace/aura-tetris/soft/tetris/strategy.aura")
(load "/workspace/aura-tetris/soft/tetris/race.aura")

(define (paint-col! x h)
  (let loop ((k 0))
    (if (< k h)
        (begin
          (tetris:fill! x (- 19 k))
          (loop (+ k 1))))))

; Jagged columns. The four objectives land on different cells.
; agg is the unique lines-then-height winner (shortest stack).
(define (paint-race-board!)
  (tetris:reset!)
  (paint-col! 0 6)
  (paint-col! 1 2)
  (paint-col! 2 5)
  (paint-col! 3 0)
  (paint-col! 4 4)
  (paint-col! 5 7)
  (paint-col! 6 3)
  (paint-col! 7 1)
  (paint-col! 8 5)
  (paint-col! 9 8))

(define (main)
  (paint-race-board!)
  (tetris:race-type! 5)
  (display "FP_AGG=")
  (display (number->string *race-fp0*))
  (newline)
  (display "FP_DEF=")
  (display (number->string *race-fp1*))
  (newline)
  (display "FP_HOLE=")
  (display (number->string *race-fp2*))
  (newline)
  (display "FP_HUNT=")
  (display (number->string *race-fp3*))
  (newline)
  (display "WORLD line=")
  (display *race-world*)
  (newline)
  (display "WINNER mid=")
  (display (number->string *race-mid*))
  (display " side=")
  (display *race-side*)
  (display " reason=")
  (display *race-reason*)
  (newline)
  (display "backend=")
  (display (number->string *race-backend*))
  (newline)
  (if (and (tetris:race-fps-differ?)
           (> *race-mid* 0)
           (string=? *race-reason* "lines_then_height")
           (or (string=? *race-world* "fiber_live")
               (string=? *race-world* "host-sequential"))
           (string=? *race-side* "agg"))
      (display "TETRIS_M3_RACE_OK\n")
      (begin
        (display "TETRIS_M3_RACE_FAIL\n")
        (display *race-world*)
        (newline)
        (display *race-side*)
        (newline))))

(main)
