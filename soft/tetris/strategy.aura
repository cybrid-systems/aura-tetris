; Placement strategy slot. The live helper is the workspace define
; tetris:place-fn, seeded once with set-code (sandbox off) and afterwards
; only hot-strategy:swap! / heal!. Score, lines, and the board are not
; written here. Proposals are strings; Soft gates them.
;
; Honesty: std/hot-strategy is present in this Soft tip, so this is the
; real swap/heal path (mutate:rebind + ast:snapshot), not a set! stand-in
; and not std/hot-update (AOT plugin reload).

(require "std/hot-strategy" all:)
(require "std/string" all:)
(require "std/mutate" all:)
(require "std/process" all:)

(define *place-body*
  "(lambda (board piece) (if (number? board) board 0))")

; Worldlines. Aggressive wants a deep landing and a rightward column.
; Defensive wants a shallow landing and a leftward column. The live
; tetris:place-fn slot stays the M1 contract (row, piece-type) -> number.
; Duel search calls place-agg / place-def with (row, column).
(define *agg-body*
  "(lambda (board piece) (if (number? board) (+ (* board 100) piece) 0))")

(define *def-body*
  "(lambda (board piece) (if (number? board) (- (* (- 0 board) 100) piece) 0))")

(define *place-live* *place-body*)

(define *strat-mid* 0)
(define *strat-reason* "boot")
(define *explain-mid* 0)
(define *explain-reason* "boot")
(define *propose-once* 0)
(define *storm-on* 0)
; 0 = live place-fn (row, type). 1 = place-agg (row, x). 2 = place-def (row, x).
(define *score-mode* 0)

(define (tetris:place-agg board piece)
  (if (number? board) (+ (* board 100) piece) 0))
(define (tetris:place-def board piece)
  (if (number? board) (- (* (- 0 board) 100) piece) 0))

; set-code only the live slot. Redefining place-agg / place-def inside
; set-code drops primitive * once the race workspace is loaded (#eval-current).
(define *seed-src*
  "(define (tetris:place-fn board piece) (if (number? board) board 0))\n")


; Human-facing stamp. Does not replace the M1 reason tag by itself.
; stderr mirrors EXPLAIN so a viewport log can show it without touching SNAP.
(define (tetris:explain! mid reason)
  (set! *explain-mid* mid)
  (set! *explain-reason* reason)
  (try
    (sh (string-append "echo EXPLAIN mid=" (number->string mid)
                       " reason=" reason " >&2"))
    (catch (e) 0))
  reason)

(define *strategy-seeded* 0)

; set-code only on the first call, and only before race.aura is loaded.
; A later set-code recompiles closures and drops primitives (cons, *).
(define (tetris:strategy-seed!)
  (if (= *strategy-seeded* 1)
      (if (tetris:probe-place!)
          (begin
            (tetris:explain! 0 "seed")
            (list #t "seed"))
          (begin
            (set! *strat-reason* "probe")
            (tetris:explain! 1 "probe")
            (list #f "probe")))
      (let ((sc (try (set-code *seed-src*) (catch (e) e))))
    (if (not (equal? sc #t))
        (begin
          (set! *strat-mid* 1)
          (set! *strat-reason* "seed")
          (list #f "seed"))
        (begin
          (eval-current)
          (hot-strategy:register! "tetris:place-fn" *place-body*)
          (set! *place-live* *place-body*)
          (set! *strategy-seeded* 1)
          (set! *strat-mid* 0)
          (set! *strat-reason* "seed")
          (if (tetris:probe-place!)
              (begin
                (tetris:explain! 0 "seed")
                (list #t "seed"))
              (begin
                (set! *strat-reason* "probe")
                (tetris:explain! 1 "probe")
                (list #f "probe"))))))))

; Reject bodies that could touch score, print, or escape the strategy slot.
(define (tetris:bad-body? s)
  (or (string-contains? s "set!")
      (string-contains? s "score")
      (string-contains? s "lines")
      (string-contains? s "display")
      (string-contains? s "mutate:")
      (string-contains? s "eval")
      (string-contains? s "load")
      (string-contains? s "shell")
      (string-contains? s "http")))

(define (tetris:body-ok? body)
  (and (string? body)
       (> (string-length body) 20)
       (< (string-length body) 2000)
       (string-prefix? body "(lambda")
       (or (string-contains? body "board")
           (string-contains? body "row"))
       (string-contains? body "piece")
       (not (tetris:bad-body? body))))

; Probe: the live helper must return a number for a plain candidate.
(define (tetris:probe-place!)
  (let ((v (try (tetris:place-fn 4 0) (catch (e) #f))))
    (number? v)))

(define (tetris:boundary-ok?)
  (and (mutate:boundary-safe?)
       (mutate:quota-ok?)))

; Gate, swap, probe. Probe failure heal!s back to the pre-swap snapshot.
; Does not write *score* / *lines* / *level*.
(define (tetris:apply-strategy! body)
  (let ((clean (if (string? body) (string-trim body) "")))
    (cond
      ((not (tetris:body-ok? clean))
       (set! *strat-mid* 1)
       (set! *strat-reason* "gate")
       (tetris:explain! 1 "gate_reject")
       (list #f "gate"))
      ((not (tetris:boundary-ok?))
       (set! *strat-mid* 1)
       (set! *strat-reason* "boundary")
       (tetris:explain! 1 "boundary")
       (list #f "boundary"))
      (#t
       ; A load after the original seed detaches mutate:rebind from the
       ; live place-fn cell (swap returns #t, the old body still runs).
       ; Refresh the set-code slot immediately before rebind. This does
       ; not rewrite place-agg / place-def and did not revert rule-score.
       (let ((keep *place-live*))
         (set! *strategy-seeded* 0)
         (tetris:strategy-seed!)
         ; strategy-seed! resets *place-live* to the seed body. Put the
         ; previous good body back so a failed probe heals to it.
         (set! *place-live* keep))
       (hot-strategy:register! "tetris:place-fn" *place-live*)
       (hot-strategy:swap! "tetris:place-fn" *place-live* "refresh-live")
       (let ((sw (hot-strategy:swap! "tetris:place-fn" clean "tetris-place")))
         (if (not (and (pair? sw) (equal? (car sw) #t)))
             (begin
               (set! *strat-mid* 1)
               (set! *strat-reason* "swap")
               (tetris:explain! 1 "swap")
               (list #f "swap"))
             (if (tetris:probe-place!)
                 (begin
                   (set! *place-live* clean)
                   (set! *strat-mid* 1)
                   (set! *strat-reason* "swap")
                   (tetris:explain! 1 "swap")
                   (list #t "swap"))
                 (begin
                   (hot-strategy:heal!)
                   (if (not (tetris:probe-place!))
                       (try
                         (hot-strategy:swap! "tetris:place-fn" *place-live* "heal-fallback")
                         (catch (e) #f)))
                   (set! *strat-mid* 1)
                   (set! *strat-reason* "heal")
                   (tetris:explain! 1 "heal")
                   (list #f "probe")))))))))

; One file drop is the M1 propose hook (no network, no score field).
; The host or an LLM writes a lambda string; Soft still gates it.
(define (tetris:maybe-propose!)
  (if (= *propose-once* 1)
      (list #f "once")
      (begin
        (set! *propose-once* 1)
        (let ((path (getenv "TETRIS_STRATEGY_FILE")))
          (if (not (and (string? path) (> (string-length path) 0)))
              (list #f "off")
              (let ((body (try (read-file path) (catch (e) #f))))
                (if (not (string? body))
                    (begin
                      (set! *strat-reason* "read")
                      (list #f "read"))
                    (tetris:apply-strategy! body))))))))


; Score one candidate. Mode 0 keeps the M1 calling convention.
(define (tetris:cand-score y x)
  (cond ((= *score-mode* 1)
         (try (tetris:place-agg y x) (catch (e) #f)))
        ((= *score-mode* 2)
         (try (tetris:place-def y x) (catch (e) #f)))
        (#t
         (try (tetris:place-fn y *ptype*) (catch (e) #f)))))

(define (tetris:sz? t)
  (or (= t 4) (= t 6)))

(define (tetris:sz-count types n)
  (let loop ((xs types) (i 0) (c 0))
    (if (or (null? xs) (>= i n))
        c
        (loop (cdr xs) (+ i 1)
              (if (tetris:sz? (car xs)) (+ c 1) c)))))

(define (tetris:sz-run types n)
  (let loop ((xs types) (i 0) (cur 0) (best 0))
    (if (or (null? xs) (>= i n))
        (if (> cur best) cur best)
        (if (tetris:sz? (car xs))
            (let ((nc (+ cur 1)))
              (loop (cdr xs) (+ i 1) nc (if (> nc best) nc best)))
            (loop (cdr xs) (+ i 1) 0 best)))))

; High S/Z ratio in the next 6, or a run of three.
(define (tetris:storm? types)
  (or (>= (tetris:sz-count types 6) 4)
      (>= (tetris:sz-run types 6) 3)))

(define (tetris:storm-heal!)
  (hot-strategy:heal!)
  (if (not (tetris:probe-place!))
      (try
        (hot-strategy:swap! "tetris:place-fn" *place-live* "storm-heal")
        (catch (e) #f)))
  (let ((v (try (tetris:place-fn 4 0) (catch (e) #f))))
    (if (and (number? v) (< v 0))
        (set! *place-live* *def-body*)
        (set! *place-live* *place-body*)))
  (set! *storm-on* 0)
  (set! *strat-mid* 1)
  (set! *strat-reason* "heal")
  (tetris:explain! 1 "heal")
  (list #t "heal"))

; Swap the live slot onto the defensive worldline, or heal when the bag calms.
; Hysteresis: enter at 4/6 or a run of 3; leave only when the next 6 hold <= 1 S/Z.
(define (tetris:storm-update! types)
  (if (tetris:storm? types)
      (if (= *storm-on* 1)
          (list #t "storm_sz")
          (let ((r (tetris:apply-strategy! *def-body*)))
            (if (and (pair? r) (equal? (car r) #t))
                (begin
                  (set! *storm-on* 1)
                  (set! *strat-mid* 2)
                  (set! *strat-reason* "storm_sz")
                  (tetris:explain! 2 "storm_sz")
                  (list #t "storm_sz"))
                r)))
      (if (and (= *storm-on* 1) (<= (tetris:sz-count types 6) 1))
          (tetris:storm-heal!)
          (list #f "calm"))))

; Landing row of pivot (y grows downward). -1 if the rotation does not fit.
(define (landing-y type rot x)
  (if (not (cells-ok? type rot x 1))
      -1
      (let loop ((y 1))
        (if (cells-ok? type rot x (+ y 1))
            (loop (+ y 1))
            y))))

(define *best-s* -999999)
(define *best-r* 0)
(define *best-x* 4)

(define (search-placement!)
  (set! *best-s* -999999)
  (set! *best-r* *prot*)
  (set! *best-x* *px*)
  (let ((rot 0))
    (while (lambda () (< rot 4))
      (lambda ()
        (let ((x 0))
          (while (lambda () (< x *W*))
            (lambda ()
              (let ((y (landing-y *ptype* rot x)))
                (if (>= y 0)
                    (let ((s (tetris:cand-score y x)))
                      (if (and (number? s) (> s *best-s*))
                          (begin
                            (set! *best-s* s)
                            (set! *best-r* rot)
                            (set! *best-x* x))))))
              (set! x (+ x 1)))))
        (set! rot (+ rot 1))))))

; One auto-pilot step toward the best candidate. Not a score write.
(define (tetris:choose-move)
  (if (= *active* 0)
      "none"
      (begin
        (search-placement!)
        (cond ((not (= *best-r* *prot*)) "cw")
              ((< *px* *best-x*) "right")
              ((> *px* *best-x*) "left")
              (#t "hard")))))

; First seed while the workspace is still world+strategy, before race.aura.
(tetris:strategy-seed!)
