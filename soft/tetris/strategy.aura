; Placement strategy slot. The live helper is the workspace define
; tetris:place-fn, seeded once with set-code (sandbox off) and afterwards
; only hot-strategy:swap! / heal!. Score, lines, and the board are not
; written here. Proposals are strings; Soft gates them.
;
; Honesty: std/hot-strategy is present in this Soft tip, so this is the
; real swap/heal path (mutate:rebind + ast:snapshot), not a set! stand-in
; and not std/hot-update (AOT plugin reload).

(require "std/hot-strategy" all:)
(require "std/string" all:)
(require "std/mutate" all:)

(define *place-body*
  "(lambda (board piece) (if (number? board) board 0))")

(define *place-live* *place-body*)

(define *strat-mid* 0)
(define *strat-reason* "boot")
(define *propose-once* 0)

(define *seed-src*
  "(define (tetris:place-fn board piece) (if (number? board) board 0))\n")

(define (tetris:strategy-seed!)
  (let ((sc (try (set-code *seed-src*) (catch (e) e))))
    (if (not (equal? sc #t))
        (begin
          (set! *strat-mid* 1)
          (set! *strat-reason* "seed")
          (list #f "seed"))
        (begin
          (eval-current)
          (hot-strategy:register! "tetris:place-fn" *place-body*)
          (set! *place-live* *place-body*)
          (set! *strat-mid* 0)
          (set! *strat-reason* "seed")
          (if (tetris:probe-place!)
              (list #t "seed")
              (begin
                (set! *strat-reason* "probe")
                (list #f "probe")))))))

; Reject bodies that could touch score, print, or escape the strategy slot.
(define (tetris:bad-body? s)
  (or (string-contains? s "set!")
      (string-contains? s "score")
      (string-contains? s "lines")
      (string-contains? s "display")
      (string-contains? s "mutate:")
      (string-contains? s "eval")
      (string-contains? s "load")
      (string-contains? s "shell")
      (string-contains? s "http")))

(define (tetris:body-ok? body)
  (and (string? body)
       (> (string-length body) 20)
       (< (string-length body) 2000)
       (string-prefix? body "(lambda")
       (string-contains? body "board")
       (string-contains? body "piece")
       (not (tetris:bad-body? body))))

; Probe: the live helper must return a number for a plain candidate.
(define (tetris:probe-place!)
  (let ((v (try (tetris:place-fn 4 0) (catch (e) #f))))
    (number? v)))

(define (tetris:boundary-ok?)
  (and (mutate:boundary-safe?)
       (mutate:quota-ok?)))

; Gate, swap, probe. Probe failure heal!s back to the pre-swap snapshot.
; Does not write *score* / *lines* / *level*.
(define (tetris:apply-strategy! body)
  (let ((clean (if (string? body) (string-trim body) "")))
    (cond
      ((not (tetris:body-ok? clean))
       (set! *strat-mid* 1)
       (set! *strat-reason* "gate")
       (list #f "gate"))
      ((not (tetris:boundary-ok?))
       (set! *strat-mid* 1)
       (set! *strat-reason* "boundary")
       (list #f "boundary"))
      (#t
       (hot-strategy:register! "tetris:place-fn" *place-live*)
       (let ((sw (hot-strategy:swap! "tetris:place-fn" clean "tetris-place")))
         (if (not (and (pair? sw) (equal? (car sw) #t)))
             (begin
               (set! *strat-mid* 1)
               (set! *strat-reason* "swap")
               (list #f "swap"))
             (if (tetris:probe-place!)
                 (begin
                   (set! *place-live* clean)
                   (set! *strat-mid* 1)
                   (set! *strat-reason* "swap")
                   (list #t "swap"))
                 (begin
                   (hot-strategy:heal!)
                   (if (not (tetris:probe-place!))
                       (try
                         (hot-strategy:swap! "tetris:place-fn" *place-live* "heal-fallback")
                         (catch (e) #f)))
                   (set! *strat-mid* 1)
                   (set! *strat-reason* "heal")
                   (list #f "probe")))))))))

; One file drop is the M1 propose hook (no network, no score field).
; The host or an LLM writes a lambda string; Soft still gates it.
(define (tetris:maybe-propose!)
  (if (= *propose-once* 1)
      (list #f "once")
      (begin
        (set! *propose-once* 1)
        (let ((path (getenv "TETRIS_STRATEGY_FILE")))
          (if (not (and (string? path) (> (string-length path) 0)))
              (list #f "off")
              (let ((body (try (read-file path) (catch (e) #f))))
                (if (not (string? body))
                    (begin
                      (set! *strat-reason* "read")
                      (list #f "read"))
                    (tetris:apply-strategy! body))))))))

; Landing row of pivot (y grows downward). -1 if the rotation does not fit.
(define (landing-y type rot x)
  (if (not (cells-ok? type rot x 1))
      -1
      (let loop ((y 1))
        (if (cells-ok? type rot x (+ y 1))
            (loop (+ y 1))
            y))))

(define *best-s* -999999)
(define *best-r* 0)
(define *best-x* 4)

(define (search-placement!)
  (set! *best-s* -999999)
  (set! *best-r* *prot*)
  (set! *best-x* *px*)
  (let ((rot 0))
    (while (lambda () (< rot 4))
      (lambda ()
        (let ((x 0))
          (while (lambda () (< x *W*))
            (lambda ()
              (let ((y (landing-y *ptype* rot x)))
                (if (>= y 0)
                    (let ((s (try (tetris:place-fn y *ptype*) (catch (e) #f))))
                      (if (and (number? s) (> s *best-s*))
                          (begin
                            (set! *best-s* s)
                            (set! *best-r* rot)
                            (set! *best-x* x))))))
              (set! x (+ x 1)))))
        (set! rot (+ rot 1))))))

; One auto-pilot step toward the best candidate. Not a score write.
(define (tetris:choose-move)
  (if (= *active* 0)
      "none"
      (begin
        (search-placement!)
        (cond ((not (= *best-r* *prot*)) "cw")
              ((< *px* *best-x*) "right")
              ((> *px* *best-x*) "left")
              (#t "hard")))))
