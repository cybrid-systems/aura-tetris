(define *W* 10)
(define *H* 20)
(define *board* (make-vector 200 0))
(define *lines* 0)
(define *score* 0)
(define *level* 1)
(define *alive* 1)
(define *tick* 0)
(define *px* 0)
(define *py* 0)
(define *prot* 0)
(define *ptype* 0)
(define *active* 0)
(define (nth xs i)
  (if (or (null? xs) (< i 0)) 0
      (if (= i 0) (car xs)
          (nth (cdr xs) (- i 1)))))
(define (count xs)
  (let loop ((ys xs) (n 0))
    (if (null? ys) n
        (loop (cdr ys) (+ n 1)))))
(define *shapes*
  (list
    (list
      (list (list -1 0) (list 0 0) (list 1 0) (list 2 0))
      (list (list 0 -1) (list 0 0) (list 0 1) (list 0 2))
      (list (list -1 0) (list 0 0) (list 1 0) (list 2 0))
      (list (list 0 -1) (list 0 0) (list 0 1) (list 0 2)))
    (list
      (list (list -1 0) (list 0 0) (list 1 0) (list -1 -1))
      (list (list 0 -1) (list 0 0) (list 0 1) (list 1 -1))
      (list (list -1 0) (list 0 0) (list 1 0) (list 1 1))
      (list (list 0 -1) (list 0 0) (list 0 1) (list -1 1)))
    (list
      (list (list -1 0) (list 0 0) (list 1 0) (list 1 -1))
      (list (list 0 -1) (list 0 0) (list 0 1) (list 1 1))
      (list (list -1 0) (list 0 0) (list 1 0) (list -1 1))
      (list (list 0 -1) (list 0 0) (list 0 1) (list -1 -1)))
    (list
      (list (list 0 0) (list 1 0) (list 0 1) (list 1 1))
      (list (list 0 0) (list 1 0) (list 0 1) (list 1 1))
      (list (list 0 0) (list 1 0) (list 0 1) (list 1 1))
      (list (list 0 0) (list 1 0) (list 0 1) (list 1 1)))
    (list
      (list (list 0 0) (list 1 0) (list -1 1) (list 0 1))
      (list (list 0 -1) (list 0 0) (list 1 0) (list 1 1))
      (list (list 0 0) (list 1 0) (list -1 1) (list 0 1))
      (list (list 0 -1) (list 0 0) (list 1 0) (list 1 1)))
    (list
      (list (list -1 0) (list 0 0) (list 1 0) (list 0 -1))
      (list (list 0 -1) (list 0 0) (list 0 1) (list 1 0))
      (list (list -1 0) (list 0 0) (list 1 0) (list 0 1))
      (list (list 0 -1) (list 0 0) (list 0 1) (list -1 0)))
    (list
      (list (list -1 0) (list 0 0) (list 0 1) (list 1 1))
      (list (list 1 -1) (list 0 0) (list 1 0) (list 0 1))
      (list (list -1 0) (list 0 0) (list 0 1) (list 1 1))
      (list (list 1 -1) (list 0 0) (list 1 0) (list 0 1)))))
(define (shape-cells type rot)
  (nth (nth *shapes* type) (modulo rot 4)))
(define (board-idx x y)
  (+ (* y *W*) x))
(define (cell-ref x y)
  (if (or (< x 0) (>= x *W*) (< y 0) (>= y *H*))
      1
      (vector-ref *board* (board-idx x y))))
(define (cell-set! x y v)
  (if (and (>= x 0) (< x *W*) (>= y 0) (< y *H*))
      (vector-set! *board* (board-idx x y) v)
      #f))
(define (tetris:reset!)
  (let loop ((i 0))
    (if (< i 200)
        (begin (vector-set! *board* i 0) (loop (+ i 1)))))
  (set! *lines* 0)
  (set! *score* 0)
  (set! *level* 1)
  (set! *alive* 1)
  (set! *tick* 0)
  (set! *px* 0)
  (set! *py* 0)
  (set! *prot* 0)
  (set! *ptype* 0)
  (set! *active* 0)
  0)
(define (cells-ok? type rot x y)
  (let loop ((cs (shape-cells type rot)))
    (if (null? cs) #t
        (let* ((c (car cs))
               (cx (+ x (nth c 0)))
               (cy (+ y (nth c 1))))
          (if (or (< cx 0) (>= cx *W*) (< cy 0) (>= cy *H*)
                  (not (= (cell-ref cx cy) 0)))
              #f
              (loop (cdr cs)))))))
(define (paint-active! v)
  (if (= *active* 0) #f
      (let loop ((cs (shape-cells *ptype* *prot*)))
        (if (null? cs) #t
            (let* ((c (car cs))
                   (cx (+ *px* (nth c 0)))
                   (cy (+ *py* (nth c 1))))
              (cell-set! cx cy v)
              (loop (cdr cs)))))))
(define (tetris:spawn! type)
  (set! *ptype* type)
  (set! *prot* 0)
  (set! *px* 4)
  (set! *py* 1)
  (if (cells-ok? *ptype* *prot* *px* *py*)
      (begin (set! *active* 1) 1)
      (begin (set! *active* 0) (set! *alive* 0) 0)))
(define (tetris:move! dx)
  (if (= *active* 0) #f
      (let ((nx (+ *px* dx)))
        (if (cells-ok? *ptype* *prot* nx *py*)
            (begin (set! *px* nx) #t)
            #f))))
(define (tetris:soft-drop!)
  (if (= *active* 0) #f
      (let ((ny (+ *py* 1)))
        (if (cells-ok? *ptype* *prot* *px* ny)
            (begin (set! *py* ny) #t)
            #f))))
(define (line-full? y)
  (let loop ((x 0))
    (if (>= x *W*) #t
        (if (= (cell-ref x y) 0) #f
            (loop (+ x 1))))))
(define (clear-row! y)
  (let loop ((yy y))
    (if (<= yy 0)
        (let fill ((x 0))
          (if (< x *W*)
              (begin (cell-set! x 0 0) (fill (+ x 1)))
              #t))
        (begin
          (let copy ((x 0))
            (if (< x *W*)
                (begin
                  (cell-set! x yy (cell-ref x (- yy 1)))
                  (copy (+ x 1)))
                #t))
          (loop (- yy 1))))))
(define (score-for n)
  (cond ((= n 1) (* 100 *level*))
        ((= n 2) (* 300 *level*))
        ((= n 3) (* 500 *level*))
        ((= n 4) (* 800 *level*))
        (#t 0)))
(define (tetris:clear-lines!)
  (let loop ((y (- *H* 1)) (n 0))
    (if (< y 0)
        (begin
          (if (> n 0)
              (begin
                (set! *lines* (+ *lines* n))
                (set! *score* (+ *score* (score-for n)))
                (set! *level* (+ 1 (quotient *lines* 10)))))
          n)
        (if (line-full? y)
            (begin
              (clear-row! y)
              (loop y (+ n 1)))
            (loop (- y 1) n)))))
(define (tetris:lock!)
  (if (= *active* 0) 0
      (begin
        (paint-active! (+ *ptype* 1))
        (set! *active* 0)
        (tetris:clear-lines!))))
(define (tetris:hard-drop!)
  (if (= *active* 0) 0
      (begin
        (let loop ()
          (if (tetris:soft-drop!)
              (loop)
              #f))
        (tetris:lock!))))
(define (tetris:rotate!)
  (if (= *active* 0) #f
      (let ((nr (modulo (+ *prot* 1) 4)))
        (let kick ((offs (list 0 -1 1)))
          (if (null? offs) #f
              (let ((ox (car offs)))
                (if (cells-ok? *ptype* nr (+ *px* ox) *py*)
                    (begin
                      (set! *prot* nr)
                      (set! *px* (+ *px* ox))
                      #t)
                    (kick (cdr offs)))))))))
(define (tetris:rotate-ccw!)
  (if (= *active* 0) #f
      (let ((nr (modulo (+ *prot* 3) 4)))
        (let kick ((offs (list 0 -1 1)))
          (if (null? offs) #f
              (let ((ox (car offs)))
                (if (cells-ok? *ptype* nr (+ *px* ox) *py*)
                    (begin
                      (set! *prot* nr)
                      (set! *px* (+ *px* ox))
                      #t)
                    (kick (cdr offs)))))))))
(define (tetris:fill! x y)
  (cell-set! x y 8))
(define (tetris:prep-I-clear!)
  (let loop ((x 0))
    (if (< x 6)
        (begin (tetris:fill! x (- *H* 1)) (loop (+ x 1)))
        #t)))
(define (tetris:drop-I-clear!)
  (tetris:prep-I-clear!)
  (tetris:spawn! 0)
  (set! *px* 7)
  (set! *py* 1)
  (set! *prot* 0)
  (if (not (cells-ok? 0 0 *px* *py*))
      (begin (set! *alive* 0) 0)
      (begin (set! *active* 1) (tetris:hard-drop!))))
(define (active-covers? x y)
  (if (= *active* 0) #f
      (let loop ((cs (shape-cells *ptype* *prot*)))
        (if (null? cs) #f
            (let* ((c (car cs))
                   (cx (+ *px* (nth c 0)))
                   (cy (+ *py* (nth c 1))))
              (if (and (= cx x) (= cy y)) #t
                  (loop (cdr cs))))))))
(define (tetris:board-row-string y)
  (let loop ((x 0) (acc ""))
    (if (>= x *W*)
        acc
        (let ((filled (or (> (cell-ref x y) 0) (active-covers? x y))))
          (loop (+ x 1)
                (string-append acc (if filled "#" ".")))))))
(define (tetris:print-board!)
  (display "+----------+\n")
  (let loop ((y 0))
    (if (< y *H*)
        (begin
          (display "|")
          (display (tetris:board-row-string y))
          (display "|\n")
          (loop (+ y 1)))))
  (display "+----------+\n")
  (display "L=")
  (display (number->string *lines*))
  (display " S=")
  (display (number->string *score*))
  (display " Lv=")
  (display (number->string *level*))
  (newline))
(define (tetris:gravity!)
  (if (= *alive* 0) #f
      (begin
        (set! *tick* (+ *tick* 1))
        (if (= *active* 0)
            (tetris:spawn! (modulo *tick* 7))
            (if (not (tetris:soft-drop!))
                (begin
                  (tetris:lock!)
                  (if (= *alive* 1)
                      (tetris:spawn! (modulo (+ *tick* 3) 7)))))))))
